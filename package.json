{
  "name": "josephomidiora-website",
  "version": "1.0.0",
  "description": "josephomidiora.com — personal website",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "translate": "node scripts/translate.js",
    "dev": "npx serve . -p 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run tests/a11y",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && stylelint 'css/**/*.css'",
    "lint:js": "eslint .",
    "lint:css": "stylelint 'css/**/*.css'",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@vitest/coverage-v8": "^2.1.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^25.0.1",
    "marked": "^14.1.0",
    "prettier": "^3.3.0",
    "serve": "^14.2.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "vitest": "^2.1.0"
  }
}
